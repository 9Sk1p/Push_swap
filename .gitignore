# ==========================================
# 42 School Universal .gitignore (C Projects)
# ==========================================

# --- Object files and libraries ---
*.o
*.a
*.so
*.dylib
*.gch
*.d

# --- Binary outputs and debug symbols ---
a.out
*.out
*.exe
*.dSYM/
core
vgcore.*
valgrind*.log

# --- OS generated files (macOS & Linux) ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# --- Editors and IDE configurations ---
.vscode/
.idea/
*.swp
*.swo
*~
